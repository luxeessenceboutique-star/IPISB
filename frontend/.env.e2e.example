# Playwright E2E test credentials — copy to .env.e2e (gitignored) and adjust
# if needed. These match the defaults created by `python backend/seed_e2e.py`,
# so leaving this file unfilled still works: playwright.config.ts falls back
# to the same hardcoded defaults when .env.e2e doesn't exist.

E2E_BASE_URL=http://localhost:5178
E2E_API_URL=http://localhost:9000

E2E_PROFESSOR_EMAIL=e2e.professor@ipisb.ma
E2E_PROFESSOR_PASSWORD=E2E_Prof_2026!

E2E_STUDENT_EMAIL=e2e.student@ipisb.ma
E2E_STUDENT_PASSWORD=E2E_Student_2026!

# Second professor, owns nothing — used only for exam ownership-boundary tests
E2E_PROFESSOR2_EMAIL=e2e.professor2@ipisb.ma
E2E_PROFESSOR2_PASSWORD=E2E_Prof2_2026!

# Optional: slow down headed runs so actions are watchable (milliseconds)
# E2E_SLOWMO=250
