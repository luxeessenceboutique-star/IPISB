# Copy to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://zftnvydmjypmcjdsczjb.supabase.co
# Service Role Key — Supabase Dashboard > Settings > API > service_role
SUPABASE_SERVICE_KEY=your_service_role_key_here
# Anon key (needed for reference only, not used by backend)
SUPABASE_ANON_KEY=your_anon_key_here

# ── Frontend ──────────────────────────────────────────────────────────────────
# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173

# ── Airtable ──────────────────────────────────────────────────────────────────
AIRTABLE_TOKEN=your_airtable_personal_access_token
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_ID=tblT7gyi0tZ51UKG4

# ── LLM (OpenAI-compatible) ───────────────────────────────────────────────────
OPENAI_BASE_URL=https://toknroutertybot.tybotflow.com/
OPENAI_API_KEY=your_openai_key_here

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_your_key_here
FROM_EMAIL=noreply@ipisb.ma

# ── Login approval gate ───────────────────────────────────────────────────────
# Receives the one-click "authorize this login" email for admin/professor
# accounts on first login and after 30 days of inactivity.
LOGIN_APPROVER_EMAIL=approver@example.com

# ── JaaS (8x8 Jitsi-as-a-Service) ─────────────────────────────────────────────
# Console: https://jaas.8x8.vc — App ID shown on dashboard, Key ID (kid) shown
# under API Keys. Download the private key file once and save it at
# backend/secrets/jaas_private_key.pem (or set JAAS_PRIVATE_KEY_PATH below).
JAAS_APP_ID=your_jaas_app_id
JAAS_API_KEY_ID=your_jaas_app_id/your_key_id
# JAAS_PRIVATE_KEY_PATH=secrets/jaas_private_key.pem
